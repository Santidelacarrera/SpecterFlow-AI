# Claves de API del Control Plane (formato: clave:rol,clave:rol). Roles: SECOPS, FINOPS, ADMIN, VIEWER
API_KEYS=secops-key:SECOPS,finops-key:FINOPS,admin-key:ADMIN,viewer-key:VIEWER
# Opcional: clasificación semántica con LLM restringido (si no se define, se usa el clasificador heurístico)
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
# Circuit breaker
BUDGET_USD=5
BUDGET_WINDOW_SEC=60
LOOP_REPEAT_THRESHOLD=5
FAILURE_RATE_THRESHOLD=0.5
